  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@vegaos-demo/tsconfig": "workspace:*",
    "cf": "^1.0.0-beta.12",
    "drizzle-kit": "^0.31.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
